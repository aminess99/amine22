   "s": 4.36,
   "e": 7.1
  },
  {
   "text": "أصابع سليكون ناعمة",
   "s": 7.1,
   "e": 8.6
  },
  {
   "text": "تعجن العظلات وتفك الشد",
   "s": 8.6,
   "e": 10.78
  },
  {
   "text": "وفي حرارة دافية",
   "s": 10.78,
   "e": 12.2
  },
  {
