 "segments": [
  {
   "text": "رقبتك وكتوفك متشنجة من الجوال والدوام",
   "s": 0.0,
   "e": 2.6
  },
  {
   "text": "جرب هالمساج الذكي",
   "s": 2.6,
   "e": 4.16
  },
  {
   "text": "يدللك كأنها يدين حقيقية",
   "s": 4.16,
   "e": 6.22
  },
  {
   "text": "أصاب أسيلكو نعمة",
   "s": 6.22,
   "e": 8.1
  },
  {
   "text": "تحجن العضلات وتفكي الشد",
   "s": 8.1,
   "e": 10.08
  },
  {
   "text": "وفي حرارة دافية ريح العضلات",
   "s": 10.08,
   "e": 12.36
  },
  {
   "text": "وتحسسك بالراحة",
   "s": 12.36,
   "e": 13.68
  },
  {
   "text": "تلبس ابثواني وتستخدم بالبيت أو بالمكتب",
   "s": 13.68,
   "e": 16.76
  },
  {
   "text": "للراقبة الكتوف الضهر",
   "s": 16.76,
   "e": 18.72
  },
  {
   "text": "وحتى الرجلين",
   "s": 18.72,
   "e": 19.98
  },
  {
   "text": "التوصيل مجاني",
   "s": 19.98,
   "e": 21.4
  },
  {
   "text": "والدفع عند الاستلام",
   "s": 21.4,
   "e": 22.64
  },
  {
   "text": "اطلب الحين قبل لا تخلص الكمية",
   "s": 22.64,
   "e": 24.88
  }
