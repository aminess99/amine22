 "segments": [
  {
   "text": "Schade, dass sie dieses Band noch nie getragen haben.",
   "s": 0.0,
   "e": 2.78
  },
  {
   "text": "Ein schmales Band für genau eine Stelle.",
   "s": 3.54,
   "e": 6.04
  },
  {
   "text": "Etwas, das eine dicke Bandage nicht schafft.",
   "s": 6.68,
   "e": 9.04
  },
  {
   "text": "Beim Treppensteigen, Aufstehen und Bücken läuft die Kraft genau hier entlang.",
   "s": 9.46,
   "e": 14.3
  },
  {
   "text": "Über die Sehne unter der Kniescheibe.",
   "s": 14.66,
   "e": 16.62
  },
  {
   "text": "Steppers sitzt genau dort.",
   "s": 16.96,
   "e": 18.66
  },
  {
   "text": "Das Luftpolster aus Silikon gibt gezielten Halt und federt jeden Schritt ab.",
   "s": 19.14,
   "e": 23.84
  },
  {
   "text": "Sie gehen wieder weiter.",
   "s": 24.14,
   "e": 25.04
  },
  {
   "text": "Sie bewegen sich freier.",
   "s": 25.44,
   "e": 26.44
  },
  {
   "text": "Einheitsgröße verstellbar.",
   "s": 27.34,
   "e": 28.7
  },
  {
   "text": "Im Sitzen in 10 Sekunden angelegt.",
   "s": 28.7,
   "e": 31.18
  },
  {
   "text": "Mit Silikon-Innenseite, die nicht verrutscht.",
   "s": 31.52,
   "e": 33.98
  },
  {
   "text": "Es drückt nicht und scheuert nicht.",
   "s": 34.26,
   "e": 35.94
  },
  {
   "text": "So leicht, dass sie es vergessen.",
   "s": 36.74,
   "e": 38.26
  },
  {
   "text": "Kaum sichtbar unter der Hose.",
   "s": 38.8,
   "e": 40.3
  },
  {
   "text": "Für jeden Tag Treppe, Garten, Spaziergang.",
   "s": 41.02,
   "e": 43.98
  },
  {
   "text": "Eins kaufen, eins gratis.",
   "s": 44.28,
   "e": 46.04
  },
  {
