 "segments": [
  {
   "text": "رجبتك تعبانا من الجوال والدوام",
   "s": 0.0,
   "e": 2.06
  },
  {
   "text": "شوف هذا المساج",
   "s": 2.06,
   "e": 3.26
  },
  {
   "text": "أصابع مثل اليد",
   "s": 3.26,
   "e": 4.76
  },
  {
   "text": "يعجل رجبتك ويفك الشت كله",
   "s": 4.76,
   "e": 7.34
  },
  {
   "text": "وفي حرارة دافية تريح العضلات",
   "s": 7.34,
   "e": 9.5
  },
  {
   "text": "تحط على رجبتك بثواني وترتاح",
   "s": 9.5,
   "e": 11.62
  },
  {
   "text": "استخدمه بالبيت بالمكتب أو بالشيارة",
   "s": 11.62,
   "e": 14.68
  },
  {
   "text": "وينفع كمال للظهر والرجلين بعد",
   "s": 14.68,
   "e": 16.86
  },
  {
   "text": "التوصيل مجهني والدفع عند الاستلام",
   "s": 16.86,
   "e": 19.2
  },
  {
   "text": "اطلب الحين قبل تخلص الكمية",
   "s": 19.2,
   "e": 21.1
  }
 ]
