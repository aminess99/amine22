 "segments": [
  {
   "text": "يومك كله على الجوال والمكتب",
   "s": 0.0,
   "e": 1.98
  },
  {
   "text": "واخرى رجبتك تعبانة",
   "s": 1.98,
   "e": 3.48
  },
  {
   "text": "شوف هذا المساج",
   "s": 3.48,
   "e": 4.56
  },
  {
   "text": "أصابعة تتحرك مثل يد المدلك بالضبط",
   "s": 4.56,
   "e": 7.84
  },
  {
   "text": "يعجين الرجبة والكتوف ويفك الشد اللي فيها",
   "s": 7.84,
   "e": 10.86
  },
  {
   "text": "وفيها حرارة دافية تريح العضلات",
   "s": 10.86,
   "e": 13.18
  },
  {
   "text": "تحط على رجبتك بثواني",
   "s": 13.18,
   "e": 14.98
  },
  {
   "text": "وترتاح وانت بالبيت أو بالمكتب",
   "s": 14.98,
   "e": 17.32
  },
  {
   "text": "وتقدر تستخدم على الظهر والرجلين بعد",
   "s": 17.32,
   "e": 19.8
  },
  {
   "text": "التوصيل مجاني والدفع عند الاستلام",
   "s": 19.8,
   "e": 22.58
  },
  {
   "text": "أطلب الحين",
   "s": 22.58,
   "e": 23.32
  }
