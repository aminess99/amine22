modules = ["web", "nodejs-22", "python-base-3.13"]

[nix]
channel = "stable-25_05"
packages = ["nspr", "nss", "atk", "at-spi2-atk", "cups", "expat", "libdrm", "libxkbcommon", "pango", "cairo", "alsa-lib", "glib", "dbus", "gtk3", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5050
externalPort = 3000

[[ports]]
localPort = 5051
externalPort = 3001

[[ports]]
localPort = 5052
externalPort = 3002

[[ports]]
localPort = 24678
externalPort = 80

[deployment]
deploymentTarget = "vm"
run = ["npm", "run", "start"]
build = ["npm", "run", "build"]
