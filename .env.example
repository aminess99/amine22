# OPENROUTER_API_KEY: Required for AI transcription through OpenRouter.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# Optional audio-capable OpenRouter model. The default supports audio input.
OPENROUTER_MODEL="google/gemini-2.5-flash"
COMMAND_MODEL="google/gemini-2.5-flash"
PLAN_MODEL="google/gemini-3.8-flash"
TTS_MODEL="google/gemini-3.8-flash-lite-tts"
VISION_MODEL="google/gemini-3.8-flash"
WHISPER_MODEL="openai/whisper-large-v3"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
FREESOUND_API_KEY="MY_FREESOUND_API_KEY"
